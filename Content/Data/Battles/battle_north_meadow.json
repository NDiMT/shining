      "actions": [
        { "type": "dialogue", "scene": "prologue_battle_flee" },
        { "type": "flee_to_exit", "unit": "spearman_2", "description": "Runs north off the battlefield edge." },
        { "type": "set_flag", "flag": "goblin_spearman_fled", "value": true }
      ],
      "notes": "The script's mid-battle beat. Maeve's line - he is not running away from us, he is running toward the Wall - is the prologue's first real clue, and it lands during gameplay rather than in a cutscene."
    }
