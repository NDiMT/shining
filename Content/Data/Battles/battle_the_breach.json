    { "asset": "set_crownwall_section", "position": [0, 11], "scale": 1.0, "notes": "Tiles east and west to fill the skyline behind the breach." },
    { "asset": "set_watchtower", "position": [10, 9], "notes": "Occupies the two 'o' tiles at [10,9] and [11,9]." },
    { "asset": "prop_guard_checkpoint", "position": [10, 8] },
    { "asset": "prop_broken_sword", "position": [4, 7], "notes": "Decoration on a walkable tile, not an obstacle." }
  ],
